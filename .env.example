# GAUNTLET_* environment variables (spec Annex E, environment variable
# reference). Copy to .env for local overrides; never commit real values —
# secrets are referenced by indirection (a path or variable name), never
# stored inline (spec §8.1).
#
# "All optional; all defaulted; none required for a safe bounded run."
#
# Empty values below are deliberate: this file documents the full surface,
# not a required set. Precedence is defaults < GAUNTLET.md < env < flags
# (spec §8); the defaults table lands with plan Task 5.

# Paths
GAUNTLET_PROJECT_ROOT=
GAUNTLET_CONFIG_DIR=
GAUNTLET_STATE_DIR=
GAUNTLET_ARTIFACT_DIR=
GAUNTLET_PLAN_DIR=
