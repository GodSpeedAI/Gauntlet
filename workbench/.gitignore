# T20 release form: the compiled artifact and its manifest are generated build
# outputs (just tui-build release) — never sources.
dist/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# just tui-dev-up/tui-dev-down: the background gauntlet-serve pidfile + log.
.dev/
